# OPTIONAL - the API boots fine without these; only POST /payment/razorpay
# needs them, and returns 503 until they're set. Use your Razorpay TEST
# account details here.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# OPTIONAL - the API boots fine without this; only POST /auth/forgot-password
# needs it, and returns 503 until it's set. Get a free API key at
# https://resend.com — you can send from onboarding@resend.dev without
# verifying your own domain while exploring this feature.
RESEND_API_KEY=""
# Leave empty to fall back to "KarmaCircle <onboarding@resend.dev>".
RESEND_FROM_EMAIL=""

# YOU CAN PUT YOUR OWN MONGODB CREDENTIALS HERE
MONGO_URI=""

# YOU CAN KEEP THIS EMPTY OR YOU CAN PUT YOUR OWN PORT NUMBER HERE
PORT="5050"

# YOU CAN PUT YOUR OWN SECRET RANDOM STRING HERE 
JWT_SECRET="thiswillbeyourrandomkey"

# YOU CAN PUT YOUR OWN GOOGLE OAUTH CREDENTIALS HERE, OR RANDOM STRINGS IF YOU ARE NOT EXPLORING THE GOOGLE OAUTH FEATURE
# Else you might need to change the callback URL in YOUR google developer console

SECRET_KEY=""
CLIENT_ID=""
CLIENT_SECRET=""
# Must match a redirect URI registered in your Google Cloud console, exactly,
# including the port.
CALLBACK_URL="http://localhost:5050/auth/google/callback"
successURL="http://localhost:3000/"

# The frontend's URL. Used for the CORS allowlist, the OAuth success redirect,
# and the password-reset link. Its scheme also decides whether auth cookies are
# marked `Secure`: http:// here keeps them working over plain-HTTP localhost.
ORIGIN_URL="http://localhost:3000"

# Any ADDITIONAL browser origins allowed to send credentialed requests, comma
# separated. ORIGIN_URL is always allowed, so locally you need nothing here.
CORS_ORIGINS=""

# The `Domain` attribute for auth cookies. LEAVE THIS EMPTY for local dev:
# Chrome rejects an explicit `Domain=localhost`, and a host-only cookie is
# what you want when the frontend and API are both on localhost. Deployments
# set it to the registrable domain the two share, e.g. ".karmacircle.org".
ORIGIN_DOMAIN=""