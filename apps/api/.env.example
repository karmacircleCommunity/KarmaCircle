# OPTIONAL - the API boots fine without these; only POST /payment/razorpay
# needs them, and returns 503 until they're set. Use your Razorpay TEST
# account details here.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# PRODUCTION ONLY - real email is sent only when NODE_ENV=production.
# Development and test capture password-reset links locally and never call
# Resend, even if this key is present. Leave empty in local .env files.
# https://resend.com
RESEND_API_KEY=""
# Production sender. Leave empty locally.
RESEND_FROM_EMAIL=""

# LOCAL DEVELOPMENT ONLY. This points to a MongoDB server on your computer.
# It works with a native install or the optional Docker setup. Use a separate
# development database; never point this at production or important personal data.
MONGO_URI="mongodb://localhost:27017/karmacircle"

# Local API port. Keep CALLBACK_URL and VITE_API_URL in sync if changing it.
PORT="5050"

# Local-only development secrets. Replace with random values if sharing this
# machine or using real accounts. Never reuse them in production.
JWT_SECRET="local-only-change-me"
SECRET_KEY="local-only-change-me"

# OAuth placeholders let the API start. Google sign-in needs credentials from
# your own Google Cloud project and a matching callback URL.
CLIENT_ID="local-dev-placeholder"
CLIENT_SECRET="local-dev-placeholder"
# Must match a redirect URI registered in your Google Cloud console, exactly,
# including the port.
CALLBACK_URL="http://localhost:5050/auth/google/callback"
successURL="http://localhost:3000/"

# Local frontend URL. Used for CORS, OAuth redirect, and password-reset links.
# Its scheme also controls whether auth cookies are marked Secure.
ORIGIN_URL="http://localhost:3000"

# Any ADDITIONAL browser origins allowed to send credentialed requests, comma
# separated. ORIGIN_URL is always allowed, so locally you need nothing here.
CORS_ORIGINS=""

# The `Domain` attribute for auth cookies. LEAVE THIS EMPTY for local dev:
# Chrome rejects an explicit `Domain=localhost`, and a host-only cookie is
# what you want when the frontend and API are both on localhost. Deployments
# set it to the registrable domain the two share, e.g. ".karmacircle.org".
ORIGIN_DOMAIN=""
