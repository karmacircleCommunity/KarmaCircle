# The web app for the local stack (docker-compose.yml at the repository root):
# the production build served by nginx. Build with the repository root as the
# context:   docker build -f apps/web/Dockerfile.stack .
# (`apps/web/Dockerfile` is the older hot-reload development container.)
FROM node:22-slim AS build

ENV CI=true
RUN corepack enable
WORKDIR /repo

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
COPY apps/api/package.json apps/api/
RUN pnpm install --frozen-lockfile --filter karmacircle-frontend...

COPY apps/web apps/web
# Where the BROWSER reaches the API. It is baked into the build, so it has to
# be an address the browser can use (localhost here), not a service name.
ARG VITE_API_URL=http://localhost:5050
ENV VITE_API_URL=$VITE_API_URL
RUN pnpm --filter karmacircle-frontend build

FROM nginx:1.27-alpine
COPY apps/web/nginx.stack.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html
EXPOSE 80
