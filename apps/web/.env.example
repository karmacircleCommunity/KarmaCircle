# Use the Backend Setup guide to setup the backend and then use the following:
VITE_API_URL="http://localhost:5050"

# If you are not exploring and checking out the razorpay payment gateway, then you can put random strings here, else you need to set up your own razorpay account and put the keys here:
VITE_RAZORPAY_KEY_ID=""

# Optional public client key for address autocomplete. Use a key you own and
# restrict it with the provider. Leave blank to use plain text address input.
VITE_GEOAPIFY_API_KEY=""

# Used by the Vercel function api/event-page.ts, not by the browser (PG-20).
# Set them in the Vercel project, not here. API_URL defaults to VITE_API_URL.
# SITE_URL is the public address used in share and search tags, for example
# https://www.karmacircle.org; without it the tags use the deployment's own
# vercel.app address.
# API_URL=""
# SITE_URL=""
