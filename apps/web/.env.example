# Use the Backend Setup guide to setup the backend and then use the following:
VITE_API_URL="http://localhost:5050"

# If you are not exploring and checking out the razorpay payment gateway, then you can put random strings here, else you need to set up your own razorpay account and put the keys here:
VITE_RAZORPAY_KEY_ID=""

# Powers the address-line autocomplete on /user/setup (individual profile edit) —
# Geoapify's free tier (3,000 requests/day, no card required) is what this is sized
# for. Get your own key at myprojects.geoapify.com (just an email signup). The key
# below is a shared public/demo one, not yours — fine for trying this out, but get
# your own before relying on it, since it may be rate-limited or revoked at any time.
# Leave this blank and the address field just falls back to a plain text input, no
# code change needed.
VITE_GEOAPIFY_API_KEY="fe6114aa2c3c4e2b98f61a26d7aca1fd"